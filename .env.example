POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto
POSTGRES_USER=crypto
POSTGRES_PASSWORD=<redacted>

# Optional: full connection string (e.g. Neon on Streamlit Cloud).
# When set, it overrides the POSTGRES_* parts above.
# Example: postgresql://user:password@ep-xxxx.neon.tech/crypto?sslmode=require
DATABASE_URL=

COINS=bitcoin,ethereum,solana
FETCH_INTERVAL_SEC=60
DASHBOARD_REFRESH_SEC=60

# Set to true on Streamlit Cloud so the app fetches prices itself
# (there is no background worker there).
CLOUD_MODE=false

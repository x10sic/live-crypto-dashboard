# Streamlit Cloud secrets for the crypto dashboard.
# In the Streamlit dashboard: app settings → Secrets → paste this.
# Get DATABASE_URL from your Neon project dashboard (connection string,
# keep the ?sslmode=require part).

DATABASE_URL = "postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
COINS = "bitcoin,ethereum,solana"
DASHBOARD_REFRESH_SEC = "60"
CLOUD_MODE = "true"
